# Existing
ANTHROPIC_API_KEY=

# Calendar (iCal)
OUTLOOK_ICAL_URL=  # outlook.live.com → Settings → Calendar → Shared calendars → Publish a calendar → copy ICS link

# GitHub
GITHUB_PAT=           # github.com/settings/tokens → fine-grained PAT with public_repo + read:user
GITHUB_USERNAME=

# Kraken
KRAKEN_API_KEY=       # account.kraken.com → Security → API → New key (read-only permissions only)
KRAKEN_API_SECRET=

# Alpha Vantage (news + supplementary data)
ALPHA_VANTAGE_KEY=    # alphavantage.co → Get a free API key

# FRED (macro data — Market Researcher)
FRED_API_KEY=         # fred.stlouisfed.org → free API key
